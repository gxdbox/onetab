<view class="page">
  <!-- 录入模式切换：单条 / 批量 -->
  <view class="mode-switch">
    <text class="mode-link {{!batch ? 'on' : ''}}" bind:tap="toggleBatch">单条录入</text>
    <text class="mode-sep">·</text>
    <text class="mode-link {{batch ? 'on' : ''}}" bind:tap="toggleBatch">多行粘贴 ›</text>
  </view>

  <!-- 批量模式：多行粘贴，一次收好 N 个 -->
  <block wx:if="{{batch}}">
    <view class="field-label serif">一行一个，一次收好</view>
    <textarea
      class="bulk-input"
      placeholder="楼下那家牛肉面&#10;周末去山里露营&#10;想看的电影"
      placeholder-class="placeholder"
      value="{{bulk}}"
      bindinput="onBulk"
      maxlength="2000"
      auto-height
    />
    <button class="btn-main submit-btn" bind:tap="submitBulk" disabled="{{saved}}">全部收好</button>
  </block>

  <!-- 单条模式 -->
  <block wx:else>
    <!-- 唯一必填项：名字 -->
    <view class="field-label serif">它叫什么</view>
    <input
      class="name-input serif"
      placeholder="比如：楼下那家牛肉面"
      placeholder-class="placeholder"
      value="{{name}}"
      bindinput="onName"
      maxlength="20"
      focus
    />

    <!-- 场景：默认已选中，可以完全不碰 [硬约束 #2]；自动猜中的标记「·猜的」 -->
    <view class="field-label">场景<text wx:if="{{sceneGuessed}}" class="guess-tag">·猜的</text></view>
    <view class="scene-chips">
      <button
        wx:for="{{scenes}}"
        wx:key="id"
        class="chip-btn {{sceneId === item.id ? 'on' : ''}}"
        data-scene="{{item.id}}"
        bind:tap="pickScene"
      >{{item.emoji}} {{item.label}}</button>
    </view>

    <!-- 照片：强烈鼓励但不强制，最多 3 张 -->
    <view class="field-label">顺手拍一张？（可跳过，最多 {{photos.length}}/3）</view>
    <view class="photo-grid">
      <view wx:for="{{photos}}" wx:key="*this" class="photo-box">
        <image class="photo-preview" src="{{item}}" mode="aspectFill" />
        <view class="photo-remove" catch:tap="removePhotoAt" data-i="{{index}}">✕</view>
      </view>
      <view wx:if="{{photos.length < 3}}" class="photo-box photo-add" bind:tap="addPhoto">📷</view>
    </view>

    <!-- 语音速记（V2）：≤ 15s，说一句而不是录一段 -->
    <view class="field-label">或者用说的？（15 秒以内，可跳过）</view>
    <view class="voice-row">
      <view wx:if="{{!audio}}" class="voice-btn {{recording ? 'recording' : ''}}" bind:tap="toggleRecord">
        <text wx:if="{{!recording}}">🎤 说一句</text>
        <block wx:else>⏺ 录音中 {{recordSecs}}s / 15s · 点击停止</block>
      </view>
      <block wx:else>
        <view class="voice-btn voice-done" bind:tap="playAudio">▶︎ 试听一下</view>
        <view class="voice-btn voice-discard" bind:tap="discardAudio">✕ 重录</view>
      </block>
    </view>

    <button class="btn-main submit-btn" bind:tap="submit" disabled="{{saved}}">收进册子</button>
  </block>

  <!-- 停留 1.5 秒：快乐被强化一次 -->
  <view wx:if="{{saved}}" class="saved-overlay">
    <view class="saved-card sketch-card">
      <view class="saved-emoji">✏️</view>
      <block wx:if="{{savedCount > 0}}">
        <view class="saved-name serif">一次收好了 {{savedCount}} 个</view>
      </block>
      <block wx:else>
        <view class="saved-name serif">{{savedName}}</view>
      </block>
      <view class="saved-sub">收进册子了，先去做它，回来给它烫金</view>
    </view>
  </view>
</view>
