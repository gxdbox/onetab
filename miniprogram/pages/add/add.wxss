.page {
  padding: 48rpx 40rpx;
}

/* 录入模式切换：单条 / 批量 */
.mode-switch {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-bottom: 12rpx;
}
.mode-link {
  font-size: 26rpx;
  color: #8b8172;
  padding: 6rpx 4rpx;
}
.mode-link.on {
  color: #a97e22;
  font-weight: 600;
}
.mode-sep {
  color: #d8cdb6;
  margin: 0 12rpx;
}

.field-label {
  color: #8b8172;
  font-size: 26rpx;
  margin: 36rpx 0 16rpx;
}
.field-label:first-child {
  margin-top: 0;
}

/* 自动猜的场景标记 */
.guess-tag {
  color: #c4b99f;
  font-size: 22rpx;
  margin-left: 8rpx;
}

.name-input {
  background: #fdf9ef;
  border: 2rpx solid #e3d5bb;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 34rpx;
}
.placeholder {
  color: #c4b99f;
}

.scene-chips {
  display: flex;
  flex-wrap: wrap;
}
.chip-btn {
  background: #f1ead9;
  border: 2rpx solid #d8ccae;
  color: #6b5f4c;
  border-radius: 999rpx;
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  margin: 6rpx 12rpx 6rpx 0;
  line-height: 1.6;
}
.chip-btn.on {
  background: #f7e9c6;
  border-color: #c9a24b;
  color: #7a6230;
  font-weight: 600;
}

/* 需求 1：新增场景 chip + 内联创建面板 */
.chip-add {
  border-style: dashed;
  border-color: #c4b99f;
  color: #8b8172;
}
.add-scene-panel {
  margin-top: 12rpx;
  background: #fdf9ef;
  border: 2rpx solid #e3d5bb;
  border-radius: 16rpx;
  padding: 20rpx;
}
.add-scene-row {
  display: flex;
  align-items: center;
}
.add-scene-input {
  flex: 1;
  background: #fffdf6;
  border: 2rpx solid #e3d5bb;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 30rpx;
  margin-right: 12rpx;
}
.btn-sm {
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  margin-left: 8rpx;
  border-radius: 999rpx;
}
.emoji-options {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.emoji-opt {
  font-size: 40rpx;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  margin: 0 8rpx 8rpx 0;
  border: 2rpx solid transparent;
}
.emoji-opt.on {
  background: #f7e9c6;
  border-color: #c9a24b;
}

/* 照片网格（≤3 张） */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
}
.photo-box {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 16rpx;
  border: 2rpx dashed #c4b99f;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-preview {
  width: 100%;
  height: 100%;
}
.photo-empty {
  font-size: 80rpx;
  opacity: 0.5;
}
/* 右上角 ✕：半透明黑底白叉 */
.photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.photo-add {
  border-style: dashed;
  font-size: 60rpx;
  opacity: 0.6;
}

/* 批量输入 */
.bulk-input {
  width: 100%;
  box-sizing: border-box;
  background: #fdf9ef;
  border: 2rpx solid #e3d5bb;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  line-height: 1.8;
  min-height: 240rpx;
}

.submit-btn {
  margin-top: 64rpx;
}

/* 语音速记（V2） */
.voice-row {
  display: flex;
}
.voice-btn {
  flex: 1;
  margin: 0 8rpx;
  padding: 20rpx 24rpx;
  border: 2rpx dashed #cbbfa8;
  border-radius: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6b5d4d;
  box-sizing: border-box;
}
.voice-btn.recording {
  border-color: #b04a3a;
  color: #b04a3a;
}
.voice-done {
  border-style: solid;
  border-color: #c9a24b;
  color: #a97e22;
}
.voice-discard {
  flex: 0 0 180rpx;
  color: #8b8172;
}

/* 收进册子的 1.5 秒 */
.saved-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(58, 47, 33, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}
.saved-card {
  width: 70%;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  animation: flyin 0.4s ease;
}
.saved-emoji {
  font-size: 80rpx;
}
.saved-name {
  font-size: 40rpx;
  margin: 20rpx 0 12rpx;
}
.saved-sub {
  font-size: 24rpx;
  color: #8b8172;
}
@keyframes flyin {
  from {
    transform: translateY(60rpx) scale(0.9);
    opacity: 0;
  }
  to {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}
