.page {
  padding: 40rpx 32rpx 60rpx;
}

.cover {
  text-align: center;
  margin-bottom: 36rpx;
}
.cover-year {
  font-size: 88rpx;
  color: #c9a24b;
  line-height: 1.2;
}
.cover-title {
  font-size: 40rpx;
  color: #4a3f35;
  margin-top: 8rpx;
}
.cover-sub {
  font-size: 24rpx;
  color: #a3967f;
  margin-top: 12rpx;
}

.stats {
  display: flex;
  padding: 36rpx 0;
  margin-bottom: 28rpx;
}
.stat {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 64rpx;
  line-height: 1.2;
}
.stat-label {
  font-size: 24rpx;
  color: #8b8172;
  margin-top: 8rpx;
}

.line {
  padding: 30rpx 32rpx;
  margin-bottom: 24rpx;
}
.line-title {
  font-size: 32rpx;
  line-height: 1.6;
}
.line-sub {
  font-size: 24rpx;
  color: #8b8172;
  margin-top: 8rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.bar-label {
  width: 200rpx;
  font-size: 24rpx;
  color: #6b5d4d;
}
.bar-track {
  flex: 1;
  height: 16rpx;
  background: #efe6d2;
  border-radius: 8rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: #c9a24b;
  border-radius: 8rpx;
}
.bar-num {
  width: 60rpx;
  text-align: right;
  font-size: 24rpx;
  color: #a3967f;
}

.foot {
  text-align: center;
  color: #a3967f;
  font-size: 24rpx;
  margin-top: 20rpx;
}

.empty {
  padding: 80rpx 40rpx;
  text-align: center;
}
.empty-title {
  font-size: 34rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #8b8172;
  margin-top: 16rpx;
  line-height: 1.6;
}
